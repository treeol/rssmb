# RSSMB — systemd unit
# Install:
#   sudo cp packaging/rssmb.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rssmb
#
# Edit ExecStart and ReadWritePaths to match your installation.

[Unit]
Description=RSSMB — Pure-Rust SMB2/3 Server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=rssmb
Group=rssmb

ExecStart=/usr/local/bin/rssmb --config /etc/rssmb/rssmb.toml

# Allow binding to privileged ports (445) without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Share root directories must be writable. Adjust to match your shares.
ReadWritePaths=/data /var/lib/rssmb

# Graceful shutdown — matches the server's shutdown_grace_secs (default 10s).
TimeoutStopSec=15
KillSignal=SIGTERM

# Restart on failure.
Restart=on-failure
RestartSec=5

# Environment.
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target